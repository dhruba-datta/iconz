<?xml version="1.0" encoding="utf-8"?>
<!--
  Iconz is only icons: no permissions, no internet, no reading of other apps.
  Play Protect flags new apps that download or install APKs, so keep it that way.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <!-- Apply: only these launchers, to offer them in the list. -->
        <package android:name="com.teslacoilsw.launcher" />
        <package android:name="app.lawnchair" />
        <package android:name="app.lawnchair.play" />
        <package android:name="ginlemon.flowerfree" />
        <package android:name="com.actionlauncher.playstore" />
        <package android:name="bitpit.launcher" />
        <package android:name="projekt.launcher" />
        <package android:name="de.mm20.launcher2.release" />
        <package android:name="com.microsoft.launcher" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Iconz">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- How launchers discover icon packs (ADW, Nova, Lawnchair, Apex, Go, Smart…). -->
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <action android:name="com.novalauncher.THEME" />
                <action android:name="com.teslacoilsw.launcher.THEME" />
                <action android:name="com.anddoes.launcher.THEME" />
                <action android:name="com.gau.go.launcherex.theme" />
                <action android:name="com.fede.launcher.THEME_ICONPACK" />
                <action android:name="com.lge.launcher2.THEME" />
                <action android:name="ginlemon.smartlauncher.THEMES" />
                <action android:name="home.solo.launcher.free.THEMES" />
                <action android:name="com.dlto.atom.launcher.THEME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.anddoes.launcher.THEME" />
                <category android:name="com.teslacoilsw.launcher.THEME" />
                <category android:name="com.fede.launcher.THEME_ICONPACK" />
            </intent-filter>
        </activity>
    </application>
</manifest>
